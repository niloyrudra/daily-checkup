{
  "compilerOptions": {
    "rootDir": "src", // compile from src
    "outDir": "lib",             // emit JS here
    "module": "CommonJS",        // required by Node runtime
    "moduleResolution": "node",  // use Node-style resolution :contentReference[oaicite:7]{index=7}
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src",
    ".eslintrc.js"
  ]
}
